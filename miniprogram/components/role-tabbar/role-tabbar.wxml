<view class="tabbar">
  <view
    class="tab-item {{current === item.key ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="key"
    data-url="{{item.url}}"
    data-key="{{item.key}}"
    bindtap="onTabTap"
  >
    <image
      class="tab-icon"
      src="{{current === item.key ? item.activeIcon : item.inactiveIcon}}"
      mode="aspectFit"
    />
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
