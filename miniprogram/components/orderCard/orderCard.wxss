.order-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(26, 26, 46, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.order-header-main {
  flex: 1;
  padding-right: 20rpx;
}

.order-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.order-no {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.status-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.2;
  flex-shrink: 0;
}

.order-body {
  margin-bottom: 22rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  font-size: 27rpx;
  line-height: 1.6;
  color: #1A1A2E;
}

.info-row .label {
  color: #8E8E93;
  flex-shrink: 0;
  width: 88rpx;
}

.value {
  flex: 1;
  color: #1A1A2E;
}

.fault-text {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #F0F1F3;
  padding-top: 20rpx;
}

.time {
  font-size: 24rpx;
  color: #C7C7CC;
}

.footer-link {
  display: flex;
  align-items: center;
}

.detail-text {
  font-size: 24rpx;
  color: #2E6CE6;
}

.arrow {
  font-size: 32rpx;
  color: #2E6CE6;
  margin-left: 6rpx;
}
