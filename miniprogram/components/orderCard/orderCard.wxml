<view class="order-card" bindtap="onTap">
  <view class="order-header">
    <view class="order-header-main">
      <text class="order-title">{{order.applianceType || '维修订单'}}</text>
      <text class="order-no">{{order.orderNo}}</text>
    </view>
    <view class="status-tag" style="background: {{statusInfo.color}}20; color: {{statusInfo.color}}">
      {{statusInfo.text}}
    </view>
  </view>
  <view class="order-body">
    <view class="info-row">
      <text class="label">电器</text>
      <text class="value">{{order.applianceType}} {{order.applianceBrand}}</text>
    </view>
    <view class="info-row">
      <text class="label">地址</text>
      <text class="value">{{order.userAddress}}</text>
    </view>
    <view class="info-row">
      <text class="label">故障</text>
      <text class="value fault-text">{{order.faultDescription}}</text>
    </view>
    <view class="info-row" wx:if="{{preferredTimeText}}">
      <text class="label">预约</text>
      <text class="value">{{preferredTimeText}}</text>
    </view>
  </view>
  <view class="order-footer">
    <text class="time">{{order.createdAt}}</text>
    <view class="footer-link">
      <text class="detail-text">查看详情</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
