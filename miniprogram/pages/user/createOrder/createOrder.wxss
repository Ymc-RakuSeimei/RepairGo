.create-order {
  padding: 20rpx 30rpx;
  padding-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.textarea-item {
  align-items: flex-start;
}

.time-item {
  align-items: flex-start;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  min-height: 120rpx;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #ccc;
}

.time-picker-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}


.time-tip.warning {
  color: #E64545;
}

.image-section {
  padding: 24rpx 0;
}

.address-panel {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.address-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-address-btn {
  font-size: 26rpx;
  color: #2E6CE6;
}

.selected-address-card {
  margin: 12rpx 0 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
}

.selected-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.selected-user {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.selected-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.selected-phone {
  font-size: 26rpx;
  color: #666;
}

.selected-tags {
  display: flex;
  gap: 12rpx;
}

.address-tag,
.default-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.address-tag {
  background: #F1F2F5;
  color: #666;
}

.default-tag {
  background: #FFF1D6;
  color: #D27B00;
}

.selected-address {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.address-empty-hint {
  margin: 12rpx 0 18rpx;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  border: 2rpx dashed #D1D1D6;
  text-align: center;
}

.hint-text {
  font-size: 26rpx;
  color: #8E8E93;
}

.address-input {
  width: 100%;
}

.image-list {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.image-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #ccc;
}

.address-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.address-selected {
  flex: 1;
}

.address-top {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.address-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-right: 16rpx;
}

.address-phone {
  font-size: 26rpx;
  color: #666;
  margin-right: 12rpx;
}

.address-tag {
  font-size: 20rpx;
  color: #2E6CE6;
  border: 1rpx solid #2E6CE6;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.address-empty {
  flex: 1;
}

.address-placeholder {
  font-size: 28rpx;
  color: #ccc;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
  margin-left: 16rpx;
}

.submit-btn {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
  width: 100%;
  height: 88rpx;
  line-height: 40rpx;
  font-size: 32rpx;
}
