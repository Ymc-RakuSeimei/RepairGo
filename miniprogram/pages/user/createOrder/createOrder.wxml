<view class="create-order">
  <view class="card">
    <view class="section-title">电器信息</view>
    <view class="form-item">
      <text class="form-label">电器类型</text>
      <picker mode="selector" range="{{applianceTypes}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="picker-value {{typeIndex < 0 ? 'placeholder' : ''}}">
          {{typeIndex >= 0 ? applianceTypes[typeIndex] : '请选择电器类型'}}
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">品牌型号</text>
      <input class="form-input" placeholder="如：格力 KFR-35GW" value="{{brand}}" data-field="brand" bindinput="onInputChange" />
    </view>
    <view class="form-item textarea-item">
      <text class="form-label">故障描述</text>
      <textarea class="form-textarea" placeholder="请详细描述故障现象" value="{{faultDesc}}" data-field="faultDesc" bindinput="onInputChange" maxlength="500" />
    </view>

    <view class="image-section">
      <text class="form-label">故障图片（可选，最多3张）</text>
      <view class="image-list">
        <view class="image-item" wx:for="{{images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="preview-img" />
          <view class="remove-btn" data-index="{{index}}" bindtap="removeImage">✕</view>
        </view>
        <view class="image-add" wx:if="{{images.length < 3}}" bindtap="chooseImage">
          <text class="add-icon">+</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">联系信息</view>
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入您的姓名" value="{{userName}}" data-field="userName" bindinput="onInputChange" />
    </view>
    <view class="form-item">
      <text class="form-label">电话</text>
      <input class="form-input" type="number" placeholder="请输入联系电话" value="{{userPhone}}" data-field="userPhone" bindinput="onInputChange" maxlength="11" />
    </view>

    <view class="address-panel">
      <view class="address-head">
        <text class="form-label">服务地址</text>
        <text class="select-address-btn" bindtap="goSelectAddress">{{selectedAddress ? '重新选择' : '选择地址'}}</text>
      </view>

      <view wx:if="{{selectedAddress}}" class="selected-address-card">
        <view class="selected-top">
          <view class="selected-user">
            <text class="selected-name">{{selectedAddress.name}}</text>
            <text class="selected-phone">{{selectedAddress.phone}}</text>
          </view>
          <view class="selected-tags">
            <text wx:if="{{selectedAddress.tag}}" class="address-tag">{{selectedAddress.tag}}</text>
            <text wx:if="{{selectedAddress.isDefault}}" class="default-tag">默认</text>
          </view>
        </view>
        <text class="selected-address">{{userAddress}}</text>
      </view>

      <input class="form-input address-input" placeholder="请输入维修地址" value="{{userAddress}}" data-field="userAddress" bindinput="onInputChange" />
    </view>

    <view class="form-item time-item">
      <text class="form-label">期望时间</text>
      <view class="time-picker-group">
        <picker
          mode="multiSelector"
          range="{{[datePickerMonths, datePickerDays]}}"
          value="{{datePickerValue}}"
          bindchange="onDateChange"
          bindcolumnchange="onDateColumnChange"
          disabled="{{noAvailablePreferredTime}}"
        >
          <view class="picker-value {{preferredDate ? '' : 'placeholder'}}">
            {{preferredDate || '请选择预约日期'}}
          </view>
        </picker>

        <picker
          mode="selector"
          range="{{timeSlotOptions}}"
          value="{{timeSlotIndex}}"
          bindchange="onTimeChange"
          disabled="{{noAvailablePreferredTime || !timeSlotOptions.length}}"
        >
          <view class="picker-value {{selectedTimeSlot ? '' : 'placeholder'}}">
            {{selectedTimeSlot || (preferredDate ? '请选择时间段' : '请先选择日期')}}
          </view>
        </picker>
        
        <text class="time-tip warning" wx:if="{{noAvailablePreferredTime}}">
          当前年度已无可预约时段
        </text>
      </view>
    </view>
  </view>

  <button class="submit-btn btn-primary" bindtap="onSubmit" disabled="{{submitting}}">
    {{submitting ? '提交中...' : '提交订单'}}
  </button>

  <view style="height: 120rpx;"></view>
  <role-tabbar role="user" current="create" />
</view>
