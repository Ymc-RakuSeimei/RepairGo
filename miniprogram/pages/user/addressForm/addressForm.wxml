<view class="address-form-page">
  <view class="card form-card">
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input
        class="form-input"
        placeholder="请输入联系人姓名"
        value="{{name}}"
        data-field="name"
        bindinput="onInputChange"
      />
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        data-field="phone"
        bindinput="onInputChange"
        maxlength="11"
      />
    </view>

    <view class="form-item">
      <text class="form-label">地址标签</text>
      <input
        class="form-input"
        placeholder="如：家、公司"
        value="{{tag}}"
        data-field="tag"
        bindinput="onInputChange"
        maxlength="10"
      />
    </view>

    <view class="form-item">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="picker-value {{region.length ? '' : 'placeholder'}}">
          {{region.length ? region.join(' ') : '请选择所在地区'}}
        </view>
      </picker>
    </view>

    <view class="form-item textarea-item">
      <text class="form-label">详细地址</text>
      <textarea
        class="form-textarea"
        placeholder="请输入街道、楼栋、门牌号"
        value="{{detail}}"
        data-field="detail"
        bindinput="onInputChange"
        maxlength="100"
      />
    </view>

    <view class="switch-row">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{isDefault}}" color="#2E6CE6" bindchange="onDefaultChange" />
    </view>
  </view>

  <button class="save-btn btn-primary" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">
    {{saving ? '保存中...' : '保存地址'}}
  </button>
</view>
