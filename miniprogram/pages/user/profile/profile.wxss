.profile-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.page-header {
  padding: 0rpx 0 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx;
}

.stats-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8E8E93;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F0F1F3;
}

.avatar-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2E6CE6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 28rpx;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.user-role {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}

.user-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.meta-item,
.meta-divider,
.user-address {
  font-size: 22rpx;
  color: #8E8E93;
}

.meta-divider {
  margin: 0 10rpx;
}

.user-address {
  display: block;
  margin-top: 8rpx;
  line-height: 1.5;
}

.menu-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item.pending {
  opacity: 0.6;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}

.logout-wrap {
  padding: 20rpx 0 0;
}

.logout-btn {
  width: 100%;
}
