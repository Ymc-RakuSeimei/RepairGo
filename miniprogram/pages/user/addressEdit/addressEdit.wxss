.address-edit-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
}

.page-header {
  padding: 120rpx 0 40rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #1A1A2E;
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A2E;
  text-align: right;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #1A1A2E;
}

.picker-value.placeholder {
  color: #C7C7CC;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  margin-left: 8rpx;
}

.tag-row {
  flex: 1;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.tag-chip {
  font-size: 24rpx;
  color: #666;
  background: #F5F5F5;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.tag-chip.active {
  color: #2E6CE6;
  background: rgba(46, 108, 230, 0.1);
}

.save-wrap {
  padding: 60rpx 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}
