<view class="address-edit-page">
  <view class="page-header">
    <text class="page-title">{{isEdit ? '编辑地址' : '新增地址'}}</text>
  </view>

  <view class="card">
    <!-- Name -->
    <view class="form-item">
      <text class="form-label">联系人</text>
      <input class="form-input" value="{{name}}" placeholder="请输入姓名" maxlength="20" data-field="name" bindinput="onInputChange" />
    </view>

    <!-- Phone -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" value="{{phone}}" placeholder="请输入手机号" maxlength="11" data-field="phone" bindinput="onInputChange" />
    </view>

    <!-- Region -->
    <view class="form-item">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="picker-value {{province ? '' : 'placeholder'}}">
          <text>{{province ? province + ' ' + city + ' ' + district : '请选择省市区'}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- Detail -->
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <input class="form-input" value="{{detail}}" placeholder="小区/街道/门牌号" maxlength="100" data-field="detail" bindinput="onInputChange" />
    </view>
  </view>

  <!-- Tags -->
  <view class="card">
    <view class="form-item">
      <text class="form-label">标签</text>
      <view class="tag-row">
        <view class="tag-chip {{tag === item ? 'active' : ''}}" wx:for="{{tags}}" wx:key="*this" data-tag="{{item}}" bindtap="onTagSelect">
          {{item}}
        </view>
      </view>
    </view>

    <!-- Default toggle -->
    <view class="form-item">
      <text class="form-label">设为默认</text>
      <switch checked="{{isDefault}}" bindchange="onDefaultChange" color="#2E6CE6" />
    </view>
  </view>

  <!-- Save button -->
  <view class="save-wrap">
    <button class="btn-primary save-btn" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>
