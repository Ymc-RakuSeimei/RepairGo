.address-list-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: 140rpx;
}

.page-header {
  padding: 120rpx 0 40rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #8E8E93;
}

.address-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.address-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.address-phone {
  font-size: 28rpx;
  color: #8E8E93;
}

.default-badge {
  font-size: 20rpx;
  color: #2E6CE6;
  background: rgba(46, 108, 230, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-badge {
  font-size: 20rpx;
  color: #FF9500;
  background: rgba(255, 149, 0, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.address-body {
  margin-bottom: 20rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.address-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F1F3;
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.radio-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #C7C7CC;
  position: relative;
}

.radio-dot.active {
  border-color: #2E6CE6;
  background: #2E6CE6;
}

.radio-dot.active::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FFFFFF;
}

.radio-text {
  font-size: 24rpx;
  color: #8E8E93;
}

.footer-right {
  display: flex;
  gap: 32rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #2E6CE6;
}

.action-btn.delete {
  color: #e74c3c;
}

.add-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}
