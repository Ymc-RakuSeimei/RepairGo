<view class="address-list-page">
  <view class="page-tip" wx:if="{{mode === 'select'}}">选择一个地址填入当前订单</view>

  <view class="address-list" wx:if="{{addresses.length}}">
    <view
      wx:for="{{addresses}}"
      wx:key="_id"
      class="card address-card"
      data-id="{{item._id}}"
      bindtap="onSelectAddress"
    >
      <view class="address-header">
        <view class="address-user">
          <text class="name">{{item.name}}</text>
          <text class="phone">{{item.phone}}</text>
        </view>
        <view class="tag-row">
          <text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text>
          <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
        </view>
      </view>

      <text class="address-text">{{item.displayAddress}}</text>

      <view class="action-row">
        <text
          class="action-text {{item.isDefault ? 'disabled' : ''}}"
          data-id="{{item._id}}"
          catchtap="onSetDefault"
        >
          {{item.isDefault ? '默认地址' : '设为默认'}}
        </text>
        <text class="action-text" data-id="{{item._id}}" catchtap="goEditAddress">编辑</text>
        <text class="action-text danger" data-id="{{item._id}}" catchtap="onDeleteAddress">删除</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty-wrap">
    <text class="empty-title">还没有保存地址</text>
    <text class="empty-sub">添加常用地址后，下单时可直接选择</text>
  </view>

  <button class="add-btn btn-primary" bindtap="goAddAddress">新增地址</button>
</view>
