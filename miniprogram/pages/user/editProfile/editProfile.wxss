.edit-profile-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
}

.page-header {
  padding: 120rpx 0 40rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.avatar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2E6CE6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.avatar-hint {
  font-size: 24rpx;
  color: #8E8E93;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: #1A1A2E;
  width: 140rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A2E;
  text-align: right;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #1A1A2E;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  margin-left: 8rpx;
}

.save-wrap {
  padding: 60rpx 0;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}
