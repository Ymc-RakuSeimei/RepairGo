<view class="edit-profile-page">
  <view class="card profile-card">
    <view class="section-title">基础资料</view>

    <view class="avatar-row">
      <text class="field-label">头像</text>
      <view class="avatar-content">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-text">{{nickName[0] || 'U'}}</text>
        </view>
        <button class="avatar-btn" bindtap="chooseAvatar" loading="{{uploading}}">
          {{uploading ? '上传中...' : '更换头像'}}
        </button>
      </view>
    </view>

    <view class="form-item">
      <text class="field-label">昵称</text>
      <input
        class="form-input"
        placeholder="请输入昵称"
        value="{{nickName}}"
        data-field="nickName"
        bindinput="onInputChange"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="field-label">手机号</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        data-field="phone"
        bindinput="onInputChange"
        maxlength="11"
      />
    </view>

    <view class="gender-group">
      <text class="field-label">性别</text>
      <view class="gender-options">
        <view
          wx:for="{{genderOptions}}"
          wx:key="value"
          class="gender-option {{gender === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onGenderChange"
        >
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <button class="save-btn btn-primary" bindtap="onSave" loading="{{saving}}" disabled="{{saving || uploading}}">
    {{saving ? '保存中...' : '保存资料'}}
  </button>
</view>
