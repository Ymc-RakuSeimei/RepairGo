<view class="user-home">
  <view class="page-header">
    <text class="page-title">维修服务</text>
    <text class="page-sub">选择您需要的服务</text>
  </view>

  <!-- Primary action -->
  <view class="primary-card" bindtap="goCreateOrder">
    <view class="primary-left">
      <view class="primary-icon">+</view>
      <view class="primary-text">
        <text class="primary-title">提交维修订单</text>
        <text class="primary-desc">描述故障，预约上门时间</text>
      </view>
    </view>
    <text class="primary-arrow">›</text>
  </view>

  <!-- Menu grid -->
  <view class="menu-grid">
    <view class="menu-item" bindtap="goOrderList">
      <text class="menu-label">我的订单</text>
      <text class="menu-sub">查看全部工单</text>
    </view>
    <view class="menu-item" bindtap="goFeedback">
      <text class="menu-label">意见反馈</text>
      <text class="menu-sub">提交问题与建议</text>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">进行中订单</text>
    <view class="section-link" bindtap="goOrderList">
      <text class="section-count" wx:if="{{ongoingOrderCount > 0}}">共 {{ongoingOrderCount}} 单</text>
      <text class="section-arrow">查看全部 ›</text>
    </view>
  </view>

  <view class="order-list" wx:if="{{ongoingOrders.length > 0}}">
    <order-card
      wx:for="{{ongoingOrders}}"
      wx:key="_id"
      order="{{item}}"
      role="user"
    />
  </view>

  <view class="empty-card" wx:if="{{!loading && ongoingOrders.length === 0}}">
    <text class="empty-title">暂无进行中订单</text>
    <text class="empty-desc">师傅接单后，订单会展示在这里，方便您随时查看进度。</text>
    <view class="empty-action" bindtap="goCreateOrder">
      <text>立即下单</text>
    </view>
  </view>

  <view style="height: 120rpx;"></view>

  <role-tabbar role="user" current="home" />
</view>
