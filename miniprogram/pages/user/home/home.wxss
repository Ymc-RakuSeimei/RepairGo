.user-home {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 120rpx 0 48rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.page-sub {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.primary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.primary-left {
  display: flex;
  align-items: center;
}

.primary-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2E6CE6;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.primary-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.primary-desc {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}

.primary-arrow {
  font-size: 40rpx;
  color: #C7C7CC;
}

.menu-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 28rpx;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.switch-role {
  text-align: center;
  padding: 40rpx 0;
}

.switch-text {
  font-size: 26rpx;
  color: #8E8E93;
}

.section-divider {
  padding: 32rpx 0 16rpx;
}

.divider-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.role-entry-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.role-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.role-info {
  flex: 1;
}

.role-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.role-desc {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.role-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}

.apply-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.apply-card.pending {
  opacity: 0.7;
}

.apply-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.apply-info {
  flex: 1;
}

.apply-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.apply-desc {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.apply-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}
