.user-home {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 80rpx 0 48rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.page-sub {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.primary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.primary-left {
  display: flex;
  align-items: center;
}

.primary-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2E6CE6;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.primary-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.primary-desc {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}

.primary-arrow {
  font-size: 40rpx;
  color: #C7C7CC;
}

.menu-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 0 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.section-link {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-count {
  font-size: 24rpx;
  color: #8E8E93;
}

.section-arrow {
  font-size: 24rpx;
  color: #2E6CE6;
}

.order-list {
  margin-bottom: 24rpx;
}

.empty-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8E8E93;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #2E6CE6;
  font-size: 24rpx;
  font-weight: 600;
}

.menu-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 28rpx;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

/* Role switch section */
.menu-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}
