<view class="apply-page">
  <view class="page-header">
    <text class="page-title">申请管理员</text>
    <text class="page-desc">提交申请后需等待开发者审核</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">申请理由</text>
      <textarea
        class="form-textarea"
        placeholder="请简述申请理由（选填）"
        value="{{reason}}"
        bindinput="onInputChange"
        maxlength="200"
      />
    </view>
  </view>

  <view class="btn-wrap">
    <button class="btn-primary" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
  </view>
</view>
