.apply-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
}

.page-header {
  padding: 80rpx 0 40rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.page-desc {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.form-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 40rpx;
}

.form-item {
  padding: 24rpx 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #1A1A2E;
  line-height: 1.6;
}

.btn-wrap {
  padding: 20rpx 0;
}
