.tech-detail { padding: 20rpx 30rpx; }
.profile-header { display: flex; align-items: center; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #4A90D9; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; margin-right: 24rpx; }
.name { font-size: 34rpx; font-weight: 600; color: #333; display: block; }
.phone { font-size: 26rpx; color: #999; display: block; margin-top: 6rpx; }
.rating-wrap { display: flex; align-items: center; margin-top: 10rpx; }
.rating-text { font-size: 24rpx; color: #f39c12; margin-left: 10rpx; }
.info-row { display: flex; padding: 16rpx 0; font-size: 28rpx; border-bottom: 1rpx solid #f0f0f0; }
.info-row .label { width: 140rpx; color: #999; flex-shrink: 0; }
.skills-row { align-items: flex-start; }
.skill-grid { flex: 1; display: flex; flex-wrap: wrap; gap: 12rpx; }
.skill-tag { padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 24rpx; background: #f0f0f0; color: #666; }
.skill-tag.active { background: #4A90D9; color: #fff; }
.skill-empty { font-size: 28rpx; color: #999; }
.action-bar { margin-top: 30rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.review-item { padding: 20rpx; }
.review-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.review-time { font-size: 22rpx; color: #bbb; }
.review-content { font-size: 26rpx; color: #333; }
