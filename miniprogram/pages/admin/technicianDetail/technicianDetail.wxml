<view class="tech-detail" wx:if="{{tech}}">
  <view class="card">
    <view class="profile-header">
      <view class="avatar">{{tech.realName[0]}}</view>
      <view class="profile-info">
        <text class="name">{{tech.realName}}</text>
        <text class="phone">{{tech.phone}}</text>
        <view class="rating-wrap">
          <star-rating rating="{{tech.rating}}" readonly="true" size="28" />
          <text class="rating-text">{{tech.rating}}分</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="info-row"><text class="label">服务区域</text><text>{{tech.serviceArea || "未设置"}}</text></view>
    <view class="info-row"><text class="label">维修技能</text><text>{{tech.skills.join("、")}}</text></view>
    <view class="info-row"><text class="label">总单数</text><text>{{tech.totalOrders}}</text></view>
    <view class="info-row"><text class="label">总收入</text><text>{{tech.totalIncome}}</text></view>
    <view class="info-row"><text class="label">状态</text><text>{{tech.status === "approved" ? "已认证" : tech.status === "pending" ? "待审核" : tech.status === "disabled" ? "已禁用" : "未通过"}}</text></view>
  </view>

  <view class="action-bar" wx:if="{{tech.status === 'pending'}}">
    <button class="btn-primary" bindtap="onApprove">审核通过</button>
    <button class="btn-danger" style="margin-top: 16rpx;" bindtap="onReject">审核拒绝</button>
  </view>

  <view class="action-bar" wx:if="{{tech.status === 'approved'}}">
    <button class="btn-danger" bindtap="onDisable">禁用账号</button>
  </view>

  <view class="section-title" style="margin-top: 30rpx;">用户评价</view>
  <view class="review-list" wx:if="{{reviews.length > 0}}">
    <view class="review-item card" wx:for="{{reviews}}" wx:key="_id">
      <view class="review-header">
        <star-rating rating="{{item.rating}}" readonly="true" size="24" />
        <text class="review-time">{{item.createdAt}}</text>
      </view>
      <text class="review-content">{{item.content}}</text>
    </view>
  </view>
  <view class="empty-state" wx:if="{{reviews.length === 0}}"><text class="empty-text">暂无评价</text></view>
</view>
