.order-list-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(247, 248, 250, 0.96);
  padding: 20rpx 24rpx 12rpx;
  backdrop-filter: blur(12rpx);
}

.tab {
  min-width: 120rpx;
  padding: 22rpx 0 18rpx;
  border-radius: 16rpx;
}

.tab.active {
  background: #FFFFFF;
}

.order-list {
  padding: 16rpx 32rpx 0;
}

.empty-state {
  padding: 180rpx 32rpx calc(220rpx + env(safe-area-inset-bottom));
}

.loading-wrap {
  padding: 60rpx 0 calc(220rpx + env(safe-area-inset-bottom));
}
