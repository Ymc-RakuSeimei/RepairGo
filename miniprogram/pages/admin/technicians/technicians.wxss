.tech-list-page { min-height: 100vh; background: #f5f5f5; }
.tech-list { padding: 20rpx 30rpx; }
.tech-card { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; }
.tech-left { display: flex; align-items: center; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #4A90D9; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 700; margin-right: 20rpx; }
.tech-name { font-size: 30rpx; font-weight: 600; color: #333; display: block; }
.tech-skills { font-size: 24rpx; color: #999; display: block; margin-top: 6rpx; }
.tech-right { display: flex; align-items: center; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 10rpx; }
.status-dot.approved { background: #27ae60; }
.status-dot.pending { background: #f39c12; }
.status-dot.rejected { background: #e74c3c; }
.status-text { font-size: 24rpx; color: #999; }
