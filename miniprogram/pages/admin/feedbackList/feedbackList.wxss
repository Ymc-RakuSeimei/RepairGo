.feedback-list-page { min-height: 100vh; background: #f5f5f5; }
.feedback-list { padding: 20rpx 30rpx; }
.feedback-card { padding: 24rpx; }
.fb-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.fb-title { font-size: 30rpx; font-weight: 600; color: #333; }
.fb-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.fb-status.open { background: #f39c1220; color: #f39c12; }
.fb-status.replied { background: #27ae6020; color: #27ae60; }
.fb-status.closed { background: #9992020; color: #999; }
.fb-content { font-size: 26rpx; color: #666; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.fb-footer { display: flex; justify-content: space-between; margin-top: 12rpx; }
.fb-user { font-size: 22rpx; color: #999; }
.fb-time { font-size: 22rpx; color: #bbb; }
