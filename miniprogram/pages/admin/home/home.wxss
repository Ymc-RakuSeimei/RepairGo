.admin-home {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 100rpx 0 36rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A2E;
}

/* Stats grid - 2 columns */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  width: 330rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.stat-num {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-num.pending { color: #FF9500; }
.stat-num.active { color: #2E6CE6; }
.stat-num.online { color: #34C759; }
.stat-num.done { color: #8E8E93; }

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}

/* Menu section */
.menu-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}
