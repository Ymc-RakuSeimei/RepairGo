.tech-home {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 80rpx 0 40rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.notice-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.notice-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.notice-desc {
  display: block;
  font-size: 26rpx;
  color: #8E8E93;
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 0;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #2E6CE6;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: #F0F1F3;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-count {
  font-size: 24rpx;
  color: #8E8E93;
  background: #F0F1F3;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}

/* Pending order cards */
.pending-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.pending-accent {
  width: 8rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #f39c12, #e67e22);
}

.pending-body {
  flex: 1;
  padding: 24rpx 28rpx;
}

.pending-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.pending-appliance-tag {
  display: inline-flex;
  align-items: center;
  background: #EBF1FF;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
}

.pending-appliance-tag text {
  font-size: 22rpx;
  color: #2E6CE6;
  font-weight: 500;
}

.pending-time {
  font-size: 22rpx;
  color: #C7C7CC;
}

.pending-no {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}

.pending-fault {
  display: block;
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pending-address-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.pending-addr-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  line-height: 1.6;
}

.pending-addr-text {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pending-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pending-brand {
  display: inline-flex;
  align-items: center;
  background: #F7F8FA;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}

.pending-brand text {
  font-size: 22rpx;
  color: #8E8E93;
}

.accept-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #2E6CE6;
  color: #FFFFFF;
  border-radius: 32rpx;
  border: none;
  margin: 0;
}

.accept-btn::after {
  border: none;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 32rpx;
}

.menu-item {
  width: calc(50% - 10rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
}

.menu-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

/* Menu section for switch button */
.menu-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C7C7CC;
}

/* Empty state enhancements */
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #C7C7CC;
  margin-top: 8rpx;
}