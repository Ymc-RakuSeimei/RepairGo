.tech-home {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 120rpx 0 40rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
}

.notice-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.notice-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.notice-desc {
  display: block;
  font-size: 26rpx;
  color: #8E8E93;
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 0;
  margin-bottom: 32rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #2E6CE6;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: #F0F1F3;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
}

.order-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.oi-header {
  margin-bottom: 16rpx;
}

.oi-no {
  font-size: 22rpx;
  color: #8E8E93;
}

.oi-row {
  display: flex;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.oi-label {
  color: #8E8E93;
  width: 80rpx;
  flex-shrink: 0;
}

.oi-value {
  color: #1A1A2E;
}

.accept-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 32rpx;
}

.menu-item {
  width: calc(50% - 10rpx);
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
}

.menu-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}
