<view class="tech-home">
  <view class="page-header">
    <text class="page-title">维修中心</text>
  </view>
  <!-- 未注册提示 -->
  <view class="notice-card" wx:if="{{!isRegistered && techInfo === null}}">
    <text class="notice-title">欢迎加入维修团队</text>
    <text class="notice-desc">请先完成注册申请，等待管理员审核</text>
    <button class="btn-primary" bindtap="goRegister">立即注册</button>
  </view>
  <!-- 审核中 -->
  <view class="notice-card" wx:if="{{techInfo && techInfo.status === 'pending'}}">
    <text class="notice-title">审核中</text>
    <text class="notice-desc">您的注册申请正在审核，请耐心等待</text>
  </view>
  <!-- 已认证 -->
  <block wx:if="{{isRegistered}}">
    <!-- Stats -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{techInfo.rating || '5.0'}}</text>
        <text class="stat-label">评分</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{techInfo.totalOrders || 0}}</text>
        <text class="stat-label">总单数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{techInfo.totalIncome || 0}}</text>
        <text class="stat-label">收入(元)</text>
      </view>
    </view>
    <!-- 待接单 -->
    <view class="section-header">
      <text class="section-title">待接订单</text>
      <text class="section-count" wx:if="{{pendingOrders.length > 0}}">
        共 {{pendingOrders.length}} 单
      </text>
    </view>
    <view class="order-list" wx:if="{{pendingOrders.length > 0}}">
      <view class="pending-card" wx:for="{{pendingOrders}}" wx:key="_id" data-id="{{item._id}}" bindtap="goOrderDetail">
        <view class="pending-accent"></view>
        <view class="pending-body">
          <view class="pending-top">
            <view class="pending-appliance-tag">
              <text>{{item.applianceType}}</text>
            </view>
            <text class="pending-time">{{item.createdAt}}</text>
          </view>
          <text class="pending-no">{{item.orderNo}}</text>
          <text class="pending-fault" wx:if="{{item.faultDescription}}">
            {{item.faultDescription}}
          </text>
          <view class="pending-address-row">
            <text class="pending-addr-icon">📍</text>
            <text class="pending-addr-text">{{item.userAddress}}</text>
          </view>
          <view class="pending-bottom">
            <view class="pending-brand" wx:if="{{item.applianceBrand}}">
              <text>{{item.applianceBrand}}</text>
            </view>
            <button class="accept-btn" data-id="{{item._id}}" catchtap="onAcceptOrder">接单</button>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!loading && pendingOrders.length === 0}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无待接订单</text>
      <text class="empty-hint">新订单将在此处显示</text>
    </view>
  </block>
  <view style="height: 120rpx;"></view>
  <role-tabbar role="technician" current="home" />
</view>