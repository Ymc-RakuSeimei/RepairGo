<view class="order-detail" wx:if="{{!loading}}">
  <view class="card">
    <view class="header-row">
      <text class="order-no">{{order.orderNo}}</text>
      <status-badge status="{{order.status}}" text="{{order.displayStatusText}}" />
    </view>
  </view>

  <view class="card">
    <view class="section-title">客户信息</view>
    <view class="info-row"><text class="label">姓名</text><text>{{order.userName}}</text></view>
    <view class="info-row"><text class="label">电话</text><text>{{order.userPhone}}</text></view>
    <view class="info-row"><text class="label">地址</text><text>{{order.userAddress}}</text></view>
    <view class="info-row" wx:if="{{order.preferredTimeText}}"><text class="label">预约时间</text><text>{{order.preferredTimeText}}</text></view>
  </view>

  <view class="card">
    <view class="section-title">电器信息</view>
    <view class="info-row"><text class="label">类型</text><text>{{order.applianceType}} {{order.applianceBrand}}</text></view>
    <view class="info-row"><text class="label">故障</text><text>{{order.faultDescription}}</text></view>
    <view class="image-row" wx:if="{{order.faultImages.length > 0}}">
      <image wx:for="{{order.faultImages}}" wx:key="*this" src="{{item}}" mode="aspectFill" class="fault-img" />
    </view>
  </view>

  <!-- 开始维修 -->
  <view class="card" wx:if="{{canStart}}">
    <view class="section-title">开始维修</view>
    <button class="btn-primary" bindtap="onStartRepair">确认上门，开始维修</button>
  </view>

  <!-- 完成维修 -->
  <view class="card" wx:if="{{canComplete}}">
    <view class="section-title">结束服务</view>
    <view class="form-item">
      <text class="form-label">维修费用(元)</text>
      <input class="form-input" type="digit" placeholder="请输入费用" value="{{price}}" data-field="price" bindinput="onInputChange" />
    </view>
    <view class="form-item" style="align-items: flex-start;">
      <text class="form-label">维修备注</text>
      <textarea class="form-textarea" placeholder="描述维修情况" value="{{repairNotes}}" data-field="repairNotes" bindinput="onInputChange" maxlength="200" />
    </view>
    <button class="btn-primary" style="margin-top: 20rpx;" bindtap="onCompleteRepair" loading="{{completing}}">提交费用，等待用户付款</button>
  </view>

  <view class="card" wx:if="{{order.status === 'awaiting_payment'}}">
    <view class="section-title">待用户付款</view>
    <view class="info-row" wx:if="{{order.price || order.price === 0}}"><text class="label">费用</text><text>¥{{order.price}}</text></view>
    <view class="info-row" wx:if="{{order.repairNotes}}"><text class="label">备注</text><text>{{order.repairNotes}}</text></view>
    <view class="info-row" wx:if="{{order.serviceFinishedAt}}"><text class="label">结束时间</text><text>{{order.serviceFinishedAt}}</text></view>
    <view class="info-row"><text class="label">状态</text><text>已提交维修结果，等待用户付款</text></view>
  </view>

  <!-- 已完成信息 -->
  <view class="card" wx:if="{{order.status === 'completed' || order.status === 'reviewed'}}">
    <view class="section-title">维修信息</view>
    <view class="info-row" wx:if="{{order.price}}"><text class="label">费用</text><text>¥{{order.price}}</text></view>
    <view class="info-row" wx:if="{{order.repairNotes}}"><text class="label">备注</text><text>{{order.repairNotes}}</text></view>
    <view class="info-row" wx:if="{{order.serviceFinishedAt}}"><text class="label">结束时间</text><text>{{order.serviceFinishedAt}}</text></view>
    <view class="info-row" wx:if="{{order.completedAt}}"><text class="label">完成时间</text><text>{{order.completedAt}}</text></view>
    <view class="info-row" wx:if="{{order.paidAt}}"><text class="label">付款时间</text><text>{{order.paidAt}}</text></view>
  </view>
</view>

<view class="loading-wrap" wx:if="{{loading}}"><text>加载中...</text></view>
