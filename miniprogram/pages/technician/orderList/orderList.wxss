.order-list-page {
  min-height: 100vh;
  background: #F7F8FA;
}

.order-list {
  padding: 20rpx 32rpx;
}

.order-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.card-status-text {
  font-size: 24rpx;
  font-weight: 500;
  margin-right: auto;
}

.card-time {
  font-size: 22rpx;
  color: #C7C7CC;
}

.card-no {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 12rpx;
}

.card-info {
  margin-bottom: 16rpx;
}

.card-row {
  display: flex;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.card-label {
  color: #8E8E93;
  width: 72rpx;
  flex-shrink: 0;
}

.card-value {
  color: #1A1A2E;
  flex: 1;
}

.card-fault {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 12rpx;
  border-top: 1rpx solid #F0F1F3;
}

.card-detail-link {
  font-size: 24rpx;
  color: #2E6CE6;
  margin-right: 8rpx;
}

.card-arrow {
  font-size: 28rpx;
  color: #2E6CE6;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
