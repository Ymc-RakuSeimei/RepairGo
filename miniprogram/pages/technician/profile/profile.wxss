.profile-page {
  padding: 20rpx 30rpx;
}

.profile-header {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #4A90D9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
}

.profile-info .name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.profile-info .phone {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

.rating-wrap {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #f39c12;
  margin-left: 10rpx;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row .label {
  width: 140rpx;
  color: #999;
  flex-shrink: 0;
}

.skills-row {
  align-items: flex-start;
}

.skill-grid {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.skill-tag {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  color: #666;
}

.skill-tag.active {
  background: #4A90D9;
  color: #fff;
}

.skill-empty {
  font-size: 28rpx;
  color: #999;
}

/* Role switch section */
.menu-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-top: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-text {
  display: flex;
  flex-direction: column;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
}

.menu-sub {
  font-size: 22rpx;
  color: #8E8E93;
  display: block;
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #C7C7CC;
}
