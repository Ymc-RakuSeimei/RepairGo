<view class="profile-page" wx:if="{{techInfo}}">
  <view class="card">
    <view class="profile-header">
      <view class="avatar-wrap">
        <text class="avatar-text">{{techInfo.realName[0] || '?'}}</text>
      </view>
      <view class="profile-info">
        <text class="name">{{techInfo.realName}}</text>
        <text class="phone">{{techInfo.phone}}</text>
        <view class="rating-wrap">
          <star-rating rating="{{techInfo.rating}}" readonly="true" size="30" />
          <text class="rating-text">{{techInfo.rating}}分</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="info-row"><text class="label">服务区域</text><text>{{techInfo.serviceArea || '未设置'}}</text></view>
    <view class="info-row"><text class="label">维修技能</text><text>{{techInfo.skills.join('、')}}</text></view>
    <view class="info-row"><text class="label">总单数</text><text>{{techInfo.totalOrders}}</text></view>
    <view class="info-row"><text class="label">总收入</text><text>¥{{techInfo.totalIncome}}</text></view>
    <view class="info-row"><text class="label">状态</text><text>{{techInfo.status === 'approved' ? '已认证' : techInfo.status === 'pending' ? '审核中' : '未通过'}}</text></view>
  </view>

  <view class="section-title">用户评价</view>
  <view class="review-list" wx:if="{{reviews.length > 0}}">
    <view class="review-item card" wx:for="{{reviews}}" wx:key="_id">
      <view class="review-header">
        <star-rating rating="{{item.rating}}" readonly="true" size="24" />
        <text class="review-time">{{item.createdAt}}</text>
      </view>
      <text class="review-content">{{item.content}}</text>
    </view>
  </view>
  <view class="empty-state" wx:if="{{reviews.length === 0}}">
    <text class="empty-text">暂无评价</text>
  </view>
</view>
