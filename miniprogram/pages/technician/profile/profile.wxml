<view class="profile-page" wx:if="{{profile}}">
  <view class="card">
    <view class="profile-header">
      <view class="avatar-wrap" bindtap="onChooseAvatar">
        <image class="avatar-img" wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <text class="avatar-text" wx:if="{{!profile.avatarUrl}}">{{profile.realName[0] || '?'}}</text>
      </view>
      <view class="profile-info">
        <text class="name">{{profile.realName}}</text>
        <text class="phone">{{profile.phone}}</text>
        <view class="rating-wrap">
          <star-rating rating="{{profile.rating}}" readonly="true" size="30" />
          <text class="rating-text">{{profile.rating}}分</text>
        </view>
      </view>
    </view>
  </view>
  <view class="card">
    <view class="info-row">
      <text class="label">服务区域</text>
      <text>{{profile.serviceArea || '未设置'}}</text>
    </view>
    <view class="info-row skills-row">
      <text class="label">维修技能</text>
      <view class="skill-grid">
        <view class="skill-tag active" wx:for="{{profile.skills}}" wx:key="*this">{{item}}</view>
        <text wx:if="{{!profile.skills.length}}" class="skill-empty">未设置</text>
      </view>
    </view>
    <view class="info-row">
      <text class="label">总单数</text>
      <text>{{profile.totalOrders}}</text>
    </view>
    <view class="info-row">
      <text class="label">总收入</text>
      <text>¥{{profile.totalIncome}}</text>
    </view>
    <view class="info-row">
      <text class="label">状态</text>
      <text>
        {{profile.status === 'approved' ? '已认证' : profile.status === 'pending' ? '审核中' : '未通过'}}
      </text>
    </view>
  </view>
  <!-- Switch role -->
  <view class="menu-section">
    <view class="menu-item" bindtap="switchToUser">
      <view class="menu-left">
        <view class="menu-dot" style="background:#2E6CE6"></view>
        <view class="menu-text">
          <text class="menu-label">切换为普通用户</text>
          <text class="menu-sub">以用户身份下单、管理订单</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>
  <view style="height: 120rpx;"></view>
  <role-tabbar role="technician" current="profile" />
</view>
