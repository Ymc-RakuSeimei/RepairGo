.index-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 40rpx;
}

.header {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-wrap {
  margin-bottom: 32rpx;
}

.logo-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2E6CE6;
}

.logo-icon {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.login-card {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-actions {
  padding: 0 20rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #2E6CE6;
  border-radius: 16rpx;
  border: none;
}

.login-btn::after {
  border: none;
}

.skip-link {
  display: block;
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #8E8E93;
}

.popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.popup-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.popup-desc {
  font-size: 26rpx;
  color: #8E8E93;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.avatar-picker {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0 0 32rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F7F8FA;
  border: 2rpx dashed #C7C7CC;
}

.avatar-picker::after {
  border: none;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7F8FA;
}

.avatar-hint {
  font-size: 22rpx;
  color: #8E8E93;
  text-align: center;
  padding: 0 16rpx;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  text-align: center;
  background: #F7F8FA;
  border-radius: 16rpx;
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

.popup-confirm-btn {
  margin-top: 0;
}
