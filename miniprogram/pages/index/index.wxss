.index-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 40rpx;
}

.header {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-wrap {
  margin-bottom: 32rpx;
}

.logo-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2E6CE6;
}

.logo-icon {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.login-card {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-actions {
  padding: 0 20rpx;
}

.phone-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #2E6CE6;
  border-radius: 16rpx;
  border: none;
}

.phone-btn::after {
  border: none;
}

.skip-link {
  display: block;
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #8E8E93;
}
