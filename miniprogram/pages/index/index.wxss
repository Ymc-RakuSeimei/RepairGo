.index-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 40rpx;
}

.header {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-wrap {
  margin-bottom: 32rpx;
}

.logo-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2E6CE6;
}

.logo-icon {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.role-list {
  width: 100%;
}

.role-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
}

.card-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.card-desc {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}

.card-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.arrow-text {
  font-size: 36rpx;
  color: #C7C7CC;
}
