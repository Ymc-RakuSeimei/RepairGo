.index-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 40rpx;
}

.header {
  padding-top: 160rpx;
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-wrap {
  margin-bottom: 32rpx;
}

.logo-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #2E6CE6;
}

.logo-icon {
  font-size: 52rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #8E8E93;
}
