<view class="index-page">
  <!-- Loading state -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="header">
      <view class="logo-wrap">
        <view class="logo-circle">
          <text class="logo-icon">R</text>
        </view>
      </view>
      <text class="title">RepairGo</text>
      <text class="subtitle">正在登录...</text>
    </view>
  </view>

  <!-- Login screen -->
  <view class="login-card" wx:if="{{showLogin}}">
    <view class="header">
      <view class="logo-wrap">
        <view class="logo-circle">
          <text class="logo-icon">R</text>
        </view>
      </view>
      <text class="title">RepairGo</text>
      <text class="subtitle">一键登录，享受便捷维修服务</text>
    </view>

    <view class="login-actions">
      <button class="login-btn" bindtap="onTapLogin" loading="{{submitting}}">
        微信一键登录
      </button>
      <text class="skip-link" bindtap="onSkipLogin">暂时跳过</text>
    </view>
  </view>

  <!-- Profile popup: avatar + nickname -->
  <view class="popup-mask" wx:if="{{showProfilePopup}}" catchtouchmove="preventMove">
    <view class="popup-panel">
      <text class="popup-title">完善微信资料</text>
      <text class="popup-desc">选择微信头像并填写昵称</text>

      <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-hint">点击获取微信头像</text>
        </view>
      </button>

      <input
        class="nickname-input"
        type="nickname"
        placeholder="点击获取微信昵称"
        value="{{nickName}}"
        bindinput="onNickNameInput"
        bindblur="onNickNameInput"
        maxlength="20"
      />

      <button class="login-btn popup-confirm-btn" bindtap="onConfirmProfile" loading="{{submitting}}">
        确认并登录
      </button>
      <text class="skip-link" bindtap="onCloseProfilePopup">取消</text>
    </view>
  </view>
</view>
