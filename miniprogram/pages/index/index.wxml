<view class="index-page">
  <!-- Loading state -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="header">
      <view class="logo-wrap">
        <view class="logo-circle">
          <text class="logo-icon">R</text>
        </view>
      </view>
      <text class="title">电器维修</text>
      <text class="subtitle">正在登录...</text>
    </view>
    <text class="title">电器维修</text>
  </view>

  <!-- Phone bind screen -->
  <view class="login-card" wx:if="{{showPhoneBind}}">
    <view class="header">
      <view class="logo-wrap">
        <view class="logo-circle">
          <text class="logo-icon">R</text>
        </view>
      </view>
      <text class="title">电器维修</text>
      <text class="subtitle">一键登录，享受便捷维修服务</text>
    </view>

    <view class="login-actions">
      <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        微信一键登录
      </button>
      <text class="skip-link" bindtap="onSkipPhone">暂时跳过</text>
    </view>
  </view>
</view>
