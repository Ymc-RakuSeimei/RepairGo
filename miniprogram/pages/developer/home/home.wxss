.dev-home {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
  padding-bottom: 80rpx;
}

.page-header {
  padding: 120rpx 0 48rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.page-sub {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8E8E93;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.menu-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.menu-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}

.menu-item.full {
  flex: none;
  width: 100%;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.menu-sub {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}
