<view class="review-page">
  <view class="page-header">
    <text class="page-title">审批管理申请</text>
    <text class="page-desc">审核用户提交的管理员申请</text>
  </view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty-state" wx:if="{{!loading && applications.length === 0}}">
    <text class="empty-text">暂无待审核的申请</text>
  </view>

  <view class="app-list" wx:if="{{!loading && applications.length > 0}}">
    <view class="app-item" wx:for="{{applications}}" wx:key="_id">
      <view class="app-info">
        <text class="app-name">{{item.nickName || '未设置昵称'}}</text>
        <text class="app-phone" wx:if="{{item.phone}}">{{item.phone}}</text>
        <text class="app-time">申请时间：{{item.updatedAt}}</text>
      </view>
      <view class="app-actions">
        <button class="btn-approve" data-id="{{item._id}}" bindtap="onApprove">通过</button>
        <button class="btn-reject" data-id="{{item._id}}" bindtap="onReject">拒绝</button>
      </view>
    </view>
  </view>
</view>
