.switch-page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 0 32rpx;
}

.page-header {
  padding: 120rpx 0 48rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 8rpx;
}

.page-sub {
  display: block;
  font-size: 28rpx;
  color: #8E8E93;
}

.role-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.role-card.active {
  border-color: #2E6CE6;
}

.role-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.role-body {
  flex: 1;
}

.role-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 6rpx;
}

.role-desc {
  display: block;
  font-size: 24rpx;
  color: #8E8E93;
}

.role-arrow {
  font-size: 40rpx;
  color: #C7C7CC;
}

.role-badge {
  background: #2E6CE6;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}
