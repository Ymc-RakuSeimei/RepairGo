/* ============================================
   CLEAN MINIMALIST — Global Styles
   ============================================ */

page {
  background-color: #F7F8FA;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #1A1A2E;
  line-height: 1.6;
}

.container {
  padding: 24rpx 32rpx;
}

/* Card */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* Buttons */
.btn-primary {
  background: #2E6CE6;
  color: #FFFFFF;
  border-radius: 12rpx;
  padding: 22rpx 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-danger {
  background: #FFFFFF;
  color: #FF3B30;
  border: 1rpx solid #FFD4D1;
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.btn-danger::after {
  border: none;
}

.btn-outline {
  background: #FFFFFF;
  color: #2E6CE6;
  border: 1rpx solid #D6E4FF;
  border-radius: 12rpx;
  padding: 18rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

/* Form */
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F1F3;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #8E8E93;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A2E;
}

/* Tabs */
.tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F1F3;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #8E8E93;
  position: relative;
}

.tab.active {
  color: #2E6CE6;
  font-weight: 600;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #2E6CE6;
  border-radius: 2rpx;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: #C7C7CC;
}

/* Loading */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
  color: #C7C7CC;
}

/* Status tag */
.status-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}
